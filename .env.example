# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# --- JKUAT Conduit weather station API ---
CONDUIT_API_KEY=your_conduit_api_key_here
CONDUIT_EMAIL=your_registered_email@example.com

# --- Africa's Talking SMS (sandbox works with username "sandbox") ---
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_sandbox_api_key_here

# --- Behaviour flags ---
# When true, sms_sender only prints messages instead of sending them.
SMS_DRY_RUN=true
