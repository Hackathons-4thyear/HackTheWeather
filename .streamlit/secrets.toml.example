# Example only. Do NOT commit a real secrets.toml - it is gitignored.
#
# LOCAL: you do not need this file. Use .env instead (see .env.example);
#        config.py reads the environment first.
#
# STREAMLIT COMMUNITY CLOUD: there is no .env, so paste these into
#        Manage app -> Settings -> Secrets, in exactly this TOML format.

CONDUIT_API_KEY = "your_conduit_api_key_here"
CONDUIT_EMAIL = "your_registered_email@example.com"

# Optional - only needed to actually send SMS. Leave SMS_DRY_RUN true for a
# public demo so nobody can spend your Africa's Talking credit.
AT_USERNAME = "sandbox"
AT_API_KEY = "your_africastalking_sandbox_api_key_here"
SMS_DRY_RUN = "true"
